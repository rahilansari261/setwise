# @defaultRequired=false
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @required @type=enum(development, production, test)
NODE_ENV=development

# Supabase project URL — Supabase dashboard > Project Settings > Data API
# @public @type=url
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — safe to ship in the app. Never put the secret key here.
# @public
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth *Web* client ID (not the Android one) — used to request an ID token
# @public
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth iOS client ID — only needed once iOS builds start
# @public
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Lets the login screen be skipped by tapping the logo 5 times. Always false for production builds.
# @public @type=boolean
EXPO_PUBLIC_ENABLE_SECRET_LOGIN=false

# Marketing site base URL, used for privacy / terms / delete-account links
# @public @type=url
EXPO_PUBLIC_SITE_URL=https://setwise.app
