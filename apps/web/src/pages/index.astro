---
import Layout from "../layouts/Layout.astro";
import { APP_NAME, PLAY_STORE_URL } from "../site.config";

const sets = [
	{ n: "W", kg: "30", reps: "12", e: "—", muted: true },
	{ n: "1", kg: "60", reps: "10", e: "80" },
	{ n: "2", kg: "60", reps: "10", e: "80" },
	{ n: "3", kg: "65", reps: "8", e: "82.3", pr: true },
];

const steps = [
	{
		n: "01",
		title: "Measure your V",
		body: "Tape your shoulders and waist. Setwise turns them into your V-taper ratio and shows the waist that would hit the golden ratio, 1.618.",
	},
	{
		n: "02",
		title: "Train what builds it",
		body: "Every split puts lats and side delts first. A weekly tracker counts your working sets for lats, side delts, rear delts and upper chest against proven ranges.",
	},
	{
		n: "03",
		title: "Watch the gap close",
		body: "Your ratio trend from every check-in, next to e1RM, records and volume for every lift.",
	},
];

const features = [
	{
		k: "V-TAPER SPLITS",
		v: "Push / Pull / Legs, Upper / Lower, Full Body and a five-day Width Split — all built around back width and delts.",
	},
	{
		k: "REST TIMER",
		v: "Starts itself after every set and pings you when rest is over, even with the screen off.",
	},
	{
		k: "PERSONAL RECORDS",
		v: "Spotted the moment you log them — heaviest set, best e1RM, best session.",
	},
	{
		k: "PLATE CALCULATOR",
		v: "Shows exactly which plates go on each side of the bar, in kg or lb.",
	},
	{
		k: "1RM + WARM-UPS",
		v: "Epley and Brzycki estimates, a percentage table and a ramp-up for any working weight.",
	},
	{
		k: "REMINDERS",
		v: "A nudge on your training days at the time you choose. Scheduled on your phone.",
	},
];
---

<Layout>
	<main>
		<section class="mx-auto grid max-w-5xl items-center gap-14 px-4 pt-10 sm:px-6 md:grid-cols-[1.1fr_0.9fr] md:pt-16">
			<div>
				<p class="label">V-taper training log · Android</p>
				<h1 class="mt-4 font-display text-[44px] font-semibold leading-[1.02] tracking-tight sm:text-6xl">
					Wide up top,<br />tight below<span class="text-volt">.</span>
				</h1>
				<p class="mt-5 max-w-md text-lg leading-relaxed text-soft">
					{APP_NAME} is the workout log for the V-taper physique. Track your shoulder-to-waist ratio,
					hit your weekly sets for lats and delts, and keep every workout on your phone, not on our
					servers.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-4">
					{
						PLAY_STORE_URL ? (
							<a
								href={PLAY_STORE_URL}
								class="inline-flex h-14 items-center gap-3 rounded-2xl bg-volt px-6 font-display text-lg font-semibold text-ink hover:brightness-95"
							>
								Get it on Google Play
							</a>
						) : (
							<span class="inline-flex h-14 items-center gap-3 rounded-2xl border border-line px-6 font-display text-lg font-semibold text-soft">
								Coming soon to Google Play
							</span>
						)
					}
					<p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Free · No ads · Works offline</p>
				</div>
			</div>

			<div class="mx-auto w-full max-w-[320px]" aria-hidden="true">
				<div class="rounded-[38px] border border-line bg-ink p-3 shadow-[0_40px_120px_-40px_rgba(198,255,61,0.18)]">
					<div class="rounded-[28px] bg-ink px-3 pb-4 pt-5">
						<div class="flex items-start justify-between px-1">
							<div>
								<p class="font-mono text-[10px] tracking-[0.14em] text-muted">THU 16 OCT</p>
								<p class="font-display text-2xl font-semibold tracking-tight">Pull · Width</p>
							</div>
							<span class="mt-1 rounded-full bg-ember-tint px-2.5 py-1 font-mono text-xs font-bold text-ember">3W</span>
						</div>
						<div class="mt-3 border-y border-hair px-1 py-2.5">
							<div class="flex items-baseline justify-between">
								<p class="font-mono text-[9px] tracking-[0.12em] text-muted">V-TAPER RATIO</p>
								<p class="font-mono text-[9px] tracking-[0.12em] text-volt">+0.06 SINCE JUL</p>
							</div>
							<p class="mt-0.5 font-display text-2xl font-semibold leading-7">1.47<span class="font-mono text-[11px] font-normal text-muted"> of 1.618</span></p>
							<div class="mt-1.5 h-1.5 overflow-hidden rounded bg-[#2A2F38]"><div class="h-1.5 w-[64%] rounded bg-volt"></div></div>
						</div>
						<div class="mt-3 rounded-2xl border border-hair bg-surface p-3">
							<p class="font-display text-[15px] font-semibold">Lat Pulldown</p>
							<p class="mt-0.5 font-mono text-[9px] tracking-[0.1em] text-muted">BACK · LAST 60 × 10 · <span class="text-volt">LATS</span></p>
							<div class="mt-2 grid grid-cols-[22px_1fr_1fr_1fr_26px] gap-1.5 border-b border-raised pb-1 font-mono text-[9px] tracking-[0.1em] text-muted">
								<span>SET</span><span>KG</span><span>REPS</span><span>e1RM</span><span></span>
							</div>
							{
								sets.map((s) => (
									<div class="grid h-8 grid-cols-[22px_1fr_1fr_1fr_26px] items-center gap-1.5 font-mono text-[13px]">
										<span class="text-[11px] text-muted">{s.n}</span>
										<span class={s.muted ? "text-muted" : ""}>
											{s.kg}
											{s.pr && (
												<span class="ml-1 rounded bg-ember-tint px-1 py-0.5 text-[8px] font-bold text-ember">PR</span>
											)}
										</span>
										<span class={s.muted ? "text-muted" : ""}>{s.reps}</span>
										<span class="text-[11px] text-muted">{s.e}</span>
										<span class="grid size-5 place-items-center rounded-full bg-volt">
											<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#0B0D10" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
										</span>
									</div>
								))
							}
							<div class="grid h-9 grid-cols-[22px_1fr_1fr_1fr_26px] items-center gap-1.5 font-mono text-[13px]">
								<span class="text-[11px] text-volt">4</span>
								<span class="rounded-md border border-line px-1.5 py-1">65</span>
								<span class="rounded-md border-[1.5px] border-volt px-1.5 py-1 text-faint">8</span>
								<span class="text-faint">—</span>
								<span class="size-5 rounded-full border-2 border-[#3A3F48]"></span>
							</div>
						</div>
						<div class="relative mt-3 flex items-center gap-2 overflow-hidden rounded-2xl border border-[#2E333C] bg-[#1A1E25] py-2 pl-3 pr-2">
							<div class="flex-1">
								<p class="font-mono text-[9px] tracking-[0.14em] text-muted">REST · LAT PULLDOWN</p>
								<p class="font-mono text-xl font-bold leading-6">01:24</p>
							</div>
							<span class="rounded-lg border border-[#2E333C] px-2 py-1.5 font-mono text-[11px]">+30s</span>
							<span class="rounded-lg bg-[#2A2F38] px-2 py-1.5 font-mono text-[11px]">Skip</span>
							<span class="absolute bottom-0 left-0 h-[3px] w-[53%] bg-volt"></span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="how" class="mx-auto mt-28 max-w-5xl px-4 sm:px-6">
			<p class="label">How it works</p>
			<h2 class="mt-3 max-w-xl font-display text-3xl font-semibold tracking-tight sm:text-4xl">
				Built for one shape: the V.
			</h2>
			<ol class="mt-10 border-t border-hair">
				{
					steps.map((s) => (
						<li class="grid gap-3 border-b border-hair py-7 sm:grid-cols-[90px_220px_1fr] sm:items-baseline sm:gap-6">
							<span class="font-mono text-sm text-volt">{s.n}</span>
							<h3 class="font-display text-xl font-semibold">{s.title}</h3>
							<p class="max-w-xl leading-relaxed text-soft">{s.body}</p>
						</li>
					))
				}
			</ol>
		</section>

		<section class="mx-auto mt-28 max-w-5xl px-4 sm:px-6">
			<div class="rounded-[28px] border border-line bg-surface p-7 sm:p-12">
				<p class="label">Privacy by design</p>
				<h2 class="mt-3 max-w-2xl font-display text-3xl font-semibold leading-tight tracking-tight sm:text-[44px]">
					Your workouts never leave your phone<span class="text-volt">.</span>
				</h2>
				<div class="mt-10 grid gap-x-10 gap-y-7 sm:grid-cols-2">
					<div>
						<p class="font-mono text-xs tracking-[0.12em] text-volt">ON YOUR PHONE</p>
						<p class="mt-2 leading-relaxed text-soft">
							Sets, routines, tape measurements and settings live in a database on your device. No cloud
							copy, no analytics, no ads.
						</p>
					</div>
					<div>
						<p class="font-mono text-xs tracking-[0.12em] text-volt">ON OUR SERVER</p>
						<p class="mt-2 leading-relaxed text-soft">
							Only your sign-in: the email and name Google or Apple share with us, so your account is yours.
						</p>
					</div>
					<div>
						<p class="font-mono text-xs tracking-[0.12em] text-volt">YOURS TO TAKE</p>
						<p class="mt-2 leading-relaxed text-soft">
							Export everything as JSON or CSV any time, and import it again on a new phone.
						</p>
					</div>
					<div>
						<p class="font-mono text-xs tracking-[0.12em] text-volt">YOURS TO DELETE</p>
						<p class="mt-2 leading-relaxed text-soft">
							Settings → Delete account removes your login and wipes the phone's data.{" "}
							<a href="/delete-account" class="text-fg underline underline-offset-4">Other ways to delete</a>.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="mx-auto mt-28 max-w-5xl px-4 sm:px-6">
			<p class="label">Also inside</p>
			<dl class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-hair bg-hair sm:grid-cols-2">
				{
					features.map((f) => (
						<div class="bg-ink p-6">
							<dt class="font-mono text-xs tracking-[0.12em] text-muted">{f.k}</dt>
							<dd class="mt-2 leading-relaxed text-soft">{f.v}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section class="mx-auto mt-28 max-w-5xl px-4 text-center sm:px-6">
			<h2 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">
				Your V starts with the next set<span class="text-volt">.</span>
			</h2>
			<p class="mt-4 text-soft">Free on Android. iPhone version on the way.</p>
		</section>
	</main>
</Layout>
