{
  "name": "setwise",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
    "check": "biome check --write ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@setwise/config": "workspace:*",
    "@types/node": "^26.4.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@12.4.2"
}
